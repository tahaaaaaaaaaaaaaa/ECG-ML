{
  "name": "mlp-binary-pathological",
  "seeds": [0, 1, 2, 3, 4],
  "training": {
    "preprocessing": "P1",
    "hidden_sizes": [128, 64],
    "dropout": 0.3,
    "loss": "CrossEntropyLoss",
    "optimizer": "AdamW",
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 128,
    "max_epochs": 200,
    "early_stopping_metric": "val_auroc_pathological",
    "patience": 20,
    "num_threads": 4
  }
}
